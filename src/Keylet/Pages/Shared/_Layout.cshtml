@{
    var initialTheme = Context.Request.Cookies["keylet-theme"] switch
    {
        "light" => "light",
        "dark" => "dark",
        _ => null
    };
    var initialThemeName = initialTheme switch
    {
        "light" => "Light",
        "dark" => "Dark",
        _ => "Auto"
    };
    var initialNextThemeName = initialTheme switch
    {
        "light" => "Dark",
        "dark" => "Auto",
        _ => "Light"
    };
    var initialThemeLabel = $"Theme: {initialThemeName}. Switch to {initialNextThemeName}.";
}
<!DOCTYPE html>
<html lang="en" data-theme="@initialTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Keylet</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <a class="brand" asp-page="/Index">Keylet</a>
        <nav aria-label="Main navigation">
            <button class="theme-toggle"
                    type="button"
                    title="@initialThemeLabel"
                    aria-label="@initialThemeLabel"
                    data-theme-toggle
                    data-theme="@(initialTheme ?? "auto")">
                <svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
                </svg>
                <svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5 8.5 8.5 0 1 0 20.5 14.5Z" />
                </svg>
                <svg class="theme-icon theme-icon-auto" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="13" rx="2" />
                    <path d="M8 21h8M12 17v4" />
                </svg>
            </button>
            <a asp-page="/Index">Configuration</a>
            <a asp-page="/Events">Events</a>
            <a href="/.well-known/openid-configuration">Discovery</a>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer>Test identity provider — never use as a production authority.</footer>
    <script src="~/theme.js" asp-append-version="true"></script>
</body>
</html>
