@page
@model LoginModel
@{
    ViewData["Title"] = "Choose account";
}

<section class="login-panel">
    <span class="eyebrow">Test sign-in</span>
    <h1>Choose an identity</h1>
    <p>No password is required. The selected configured identity will be returned to <strong>@(Model.ClientName ?? "the requesting application")</strong>.</p>

    <div class="account-list">
        @foreach (var user in Model.Users)
        {
            <form method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" name="Subject" value="@user.Subject" />
                <button type="submit" class="account-button">
                    <span>
                        <strong>@user.Name</strong>
                        <small>@(user.Email ?? user.PreferredUsername ?? user.Subject)</small>
                    </span>
                    <span class="roles">@(user.Roles.Count == 0 ? "No roles" : string.Join(" · ", user.Roles))</span>
                </button>
            </form>
        }
    </div>

    @if (Model.CanDenySignIn)
    {
        <form method="post" action="@(Request.PathBase + "/connect/authorize")" class="deny-sign-in">
            @Html.AntiForgeryToken()
            @foreach (var parameter in Model.AuthorizationParameters)
            {
                @foreach (var value in parameter.Value)
                {
                    <input type="hidden" name="@parameter.Key" value="@value" />
                }
            }
            <button type="submit" name="keylet_action" value="deny" class="account-button">Deny sign-in</button>
        </form>
    }
</section>
