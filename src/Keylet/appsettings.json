{
  "Keylet": {
    "Mode": "Interactive",
    "AutomaticUser": "admin",
    "AllowLoginHint": true,
    "AllowInsecureHttp": true,
    "EventCapacity": 500,
    "Users": [
      {
        "Subject": "admin",
        "Name": "Test Administrator",
        "PreferredUsername": "admin",
        "Email": "admin@keylet.local",
        "EmailVerified": true,
        "Roles": [ "Admin", "User" ]
      },
      {
        "Subject": "user",
        "Name": "Test User",
        "PreferredUsername": "user",
        "Email": "user@keylet.local",
        "EmailVerified": true,
        "Roles": [ "User" ]
      }
    ],
    "Clients": [
      {
        "ClientId": "sample-web",
        "ClientSecret": "sample-web-secret",
        "DisplayName": "Sample web application",
        "RedirectUris": [ "https://localhost:7180/signin-oidc" ],
        "PostLogoutRedirectUris": [ "https://localhost:7180/signout-callback-oidc" ],
        "AllowedScopes": [ "openid", "profile", "email", "roles" ],
        "AllowRefreshTokens": false,
        "RequirePkce": true
      },
      {
        "ClientId": "keylet-test-client",
        "ClientSecret": "keylet-test-client-secret",
        "DisplayName": "Keylet test client",
        "RedirectUris": [ "https://localhost:7294/signin-oidc" ],
        "PostLogoutRedirectUris": [ "https://localhost:7294/signout-callback-oidc" ],
        "AllowedScopes": [ "openid", "profile", "email", "roles" ],
        "AllowRefreshTokens": false,
        "RequirePkce": true
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "OpenIddict": "Information"
    }
  },
  "AllowedHosts": "*"
}
